PORT=8888
HOST=localhost
APP_PREFIX=/api
APP_NAME=nestjs_online_courses
NODE_ENV=development

APP_URL=http://${HOST}:${PORT}${APP_PREFIX}

FE_URL=http://localhost:5173

DATABASE_URL="mongodb+srv://your_db_user:your_db_password@your_cluster.mongodb.net/your_db_name?retryWrites=true&w=majority"

DB_USER=user_nestjs_online_courses
DB_PASSWORD=password_nestjs_online_courses
DB_NAME=db_nestjs_online_courses
DB_PORT=27017

JWT_SECRET=your_jwt_secret_key
RESET_TOKEN_SECRET=your_reset_token_secret_key

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:9999/api/auth/google/callback